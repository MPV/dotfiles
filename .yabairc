#!/usr/bin/env sh

# the scripting-addition must be loaded manually if
# you are running yabai on macOS Big Sur. Uncomment
# the following line to have the injection performed
# when the config is executed during startup.
#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#macos-big-sur---automatically-load-scripting-addition-on-startup

sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# Workaround for native tabs until fixed in https://github.com/koekeishiya/yabai/issues/68
#yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --focus next; sleep 0.01; yabai -m space --focus prev'
#yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --focus next; sleep 0.01; yabai -m space --focus prev'
# https://ghostty.org/docs/help/macos-tiling-wms#yabai
yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'
yabai -m signal --add app='^Finder$' event=window_created action='yabai -m space --focus next; sleep 0.01; yabai -m space --focus prev'
yabai -m signal --add app='^Finder$' event=window_destroyed action='yabai -m space --focus next; sleep 0.01; yabai -m space --focus prev'

# Route these apps to the first portrait-oriented (vertical) display whenever a window is created.
for app_regex in '^Spotify$' '^Google Chat$' '^Discord$' '^Microsoft Teams$'; do
    # Display is resolved per-event so hot-swapping vertical monitors works without restarting yabai.
    # Skip if already fullscreen — macOS restores prior fullscreen state on relaunch, and `--toggle` would flip it off.
    # Sleep before toggle lets the display-move settle so the AX fullscreen request isn't dropped mid-animation.
    # Verify-and-retry covers slow-settling apps (e.g. Google Chat) that drop the first AX request while still loading.
    yabai -m signal --add event=window_created app="${app_regex}" \
        action="yabai -m query --windows --window \$YABAI_WINDOW_ID | jq -e '.[\"is-native-fullscreen\"]' >/dev/null && exit 0; \
                vertical_display=\$(yabai -m query --displays | jq '.[] | select(.frame.h > .frame.w) | .index' | head -n1); \
                yabai -m window \$YABAI_WINDOW_ID --display \$vertical_display; \
                sleep 1.0; \
                yabai -m window \$YABAI_WINDOW_ID --toggle native-fullscreen; \
                sleep 1.5; \
                yabai -m query --windows --window \$YABAI_WINDOW_ID | jq -e '.[\"is-native-fullscreen\"]' >/dev/null && exit 0; \
                yabai -m window \$YABAI_WINDOW_ID --toggle native-fullscreen"
done

# global settings
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          autofocus # autoraise
yabai -m config window_placement             second_child
yabai -m config window_topmost               off
#yabai -m config window_opacity               off
#yabai -m config window_opacity_duration      0.0
yabai -m config window_shadow                on
#yabai -m config window_border                on
#yabai -m config window_border_placement      inset
#yabai -m config window_border_width          2
#yabai -m config window_border_radius         -1.0
#yabai -m config active_window_border_topmost off
##yabai -m config active_window_border_color   0xff775759
#yabai -m config active_window_border_color   0xff0f6288
#yabai -m config normal_window_border_color   0xff505050
#yabai -m config insert_window_border_color   0xffd75f5f
#yabai -m config active_window_opacity        1.0
#yabai -m config normal_window_opacity        0.90
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 on
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                resize # move
yabai -m config mouse_action2                move   # resize

# general space settings
yabai -m config layout                       bsp
yabai -m config top_padding                  0 # 10
yabai -m config bottom_padding               0 # 10
yabai -m config left_padding                 0 # 10
yabai -m config right_padding                0 # 10
yabai -m config window_gap                   0 # 10

# ====== List of rules =========================

yabai -m rule --add label="Finder" app="^Finder$" title="(Kopiera|Anslut|Flytta|info|Finder-inställningar)" manage=off topmost=on border=off
yabai -m rule --add label="System Preferences" title="^Systeminställningar$" manage=off border=off
yabai -m rule --add label="Musik" app="Musik" title="Minispelare" manage=off border=off
# yabai -m rule --add label="OmniFocus" app="OmniFocus" title="Perspectives" manage=off border=off
# yabai -m rule --add label="OmniFocus" app="OmniFocus" title=".* Preferences$" manage=off border=off
yabai -m rule --add label="Tandem" app="Tandem" manage=off border=off
yabai -m rule --add label="Airfoil Satellite" app="Airfoil Satellite" manage=off border=off
yabai -m rule --add label="League of Legends" app="League of Legends" manage=off border=off
yabai -m rule --add label="Pop" app="Pop" manage=off border=off
yabai -m rule --add label="Rocket" app="Rocket" manage=off border=off
yabai -m rule --add label="IDEA" app="IntelliJ IDEA" manage=off border=off
#yabai -m rule --add label="IDEA" app="IntelliJ IDEA" title=" - " manage=off border=off

# yabai -m rule --add label="App Store" app="^App Store$" manage=off
# yabai -m rule --add label="Activity Monitor" app="^Activity Monitor$" manage=off
# yabai -m rule --add label="Calculator" app="^Calculator$" manage=off
# yabai -m rule --add label="Dictionary" app="^Dictionary$" manage=off
# yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off

echo "yabai configuration loaded.."
